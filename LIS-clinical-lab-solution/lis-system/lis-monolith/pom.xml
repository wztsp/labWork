        </dependency>
        <dependency>
            <groupId>com.lis</groupId>
            <artifactId>lis-service-instrument</artifactId>
            <version>1.0.0</version>
            <exclusions>
                <exclusion>
                    <groupId>com.alibaba.cloud</groupId>
