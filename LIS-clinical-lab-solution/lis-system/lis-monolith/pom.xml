    </dependencies>

    <build>
        <finalName>lis-monolith-fresh</finalName>
        <plugins>
            <!-- 把前端 dist 复制到后端 static 目录，实现前后端一体化 -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>validate</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <property name="frontend.dist" value="${project.basedir}/../../lis-frontend/dist"/>
                                <property name="backend.static" value="${project.basedir}/src/main/resources/static"/>
                                <!-- 清理旧 static -->
                                <delete dir="${backend.static}" failonerror="false"/>
                                <copy todir="${backend.static}" overwrite="true" failonerror="false">
                                    <fileset dir="${frontend.dist}" erroronmissingdir="false"/>
                                </copy>
                                <echo message="前端复制完成 (dist=${frontend.dist}, static=${backend.static})"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.lis.monolith.LisMonolithApplication</mainClass>
                    <!-- 允许依赖的 starter 自动配置 -->
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.cloud</groupId>
                            <artifactId>spring-cloud-starter</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
