{
  "name": "lis-admin-server",
  "version": "1.0.0",
  "private": true,
  "description": "LIS 运维后台管理系统 —— 后端服务（Express + TypeScript + SQLite）",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch & node --experimental-sqlite --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
