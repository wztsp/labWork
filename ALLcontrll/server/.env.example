# ===== LIS 运维后台管理系统 —— 后端环境变量示例 =====
# 复制为 .env 后按需修改（所有项均有内置默认值，可全部省略）

# HTTP 服务监听端口
PORT=8900

# SQLite 数据库文件路径（相对路径以 server/ 目录为基准）
DB_PATH=data/lis-admin.db

# 单次健康探测超时时间（毫秒）
HEALTH_CHECK_TIMEOUT_MS=3000

# 日志文件上传大小上限（MB）
MAX_UPLOAD_SIZE_MB=50

# 生产模式下托管的前端静态文件目录（相对路径以 server/ 目录为基准）
STATIC_DIR=../web/dist

# 运行环境：development | production
NODE_ENV=development
